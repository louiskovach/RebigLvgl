# ---- Target / flash (ESP32-S3 N16R8) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- Console (log + PLC debugger) on UART0 = the USB-C port (COM port in the IDE) ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE_115200=y

# ---- Octal PSRAM (frame buffers live here) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ---- Cache (helps RGB panel bandwidth) ----
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- RGB LCD ----
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# ---- LVGL ----
# LVGL objects in PSRAM (main/lv_mem_psram.c), keeps internal RAM for Wi-Fi
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_36=y

# ---- Wi-Fi / lwIP buffers in PSRAM (keeps internal RAM for the display) ----
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# fewer fixed Wi-Fi receive buffers (each 1.6 KB of internal RAM); plenty for SNTP / web page
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# allow EXT_RAM_BSS_ATTR (PLC tables in PSRAM)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# PLC debugger (serial console). Set to n for production.
CONFIG_PLC_DEBUG=y
