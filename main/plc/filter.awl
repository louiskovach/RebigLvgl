ORGANIZATION_BLOCK MAIN:OB1
TITLE=PROGRAM COMMENTS
BEGIN
Network 1 
// Idle State 0  
LD     SM0.1
O      I0.2
OB=    VB202, 14
O      Q1.1
LDB=   VB202, 18
AN     Q0.6
OLD
MOVB   0, VB202
Network 2 // Network Title
// State 1 Regen open then delay after start pulse
Network 3 
// Exit State 1 to State 2. Regen valve timer complete. Move to State 2 turn pump on
LDN    I0.2
AN     V204.0
AN     V210.0
LPS
LDB=   VB202, 0
A      V230.0
OB=    VB202, 19
ALD
MOVB   1, VB202
LPP
LPS
A      T37
MOVB   2, VB202
LRD
A      T38
MOVB   3, VB202
LRD
A      T39
MOVB   4, VB202
LRD
A      T40
MOVB   5, VB202
LRD
A      T41
MOVB   6, VB202
LPP
AB=    VB202, 0
A      Q0.4
MOVB   15, VB202
Network 4 
// State 1 Transition logic, Regen Valve Timer delay to Pump on (preset VW300, set by HMI)
LDB=   VB202, 1
TON    T37, VW300
Network 5 
// State 2 Transition logic, Motor on then delay to next state, regen filter (preset VW302)
LDB=   VB202, 2
TON    T38, VW302
Network 6 
// State 3 Transition logic, Coat media on to filter tubes (preset VW304)
LDB=   VB202, 3
TON    T39, VW304
Network 7 
// State 4 Transition logic, Effluent valve delay before regen valve closed (preset VW306)
LDB=   VB202, 4
TON    T40, VW306
Network 8 
// State 5 Transition logic, Regen Valve Closed Delay time (preset VW308)
LDB=   VB202, 5
TON    T41, VW308
Network 9 
Network 10 
Network 11 
Network 12 
LD     I1.2
LD     Q0.4
AB<>   VB202, 0
OLD
EU
=      V204.1
Network 13 
// Cancel run, once user stop pressed stay there until idle state is achieved
LD     V204.1
O      V204.0
AB<>   VB202, 0
AB<    VB202, 15
=      V204.0
Network 14 
// User Stop pulse found, change to correct exit state based on current state
LDN    I0.2
LD     V204.1
O      Q0.4
ALD
LPS
LDB=   VB202, 6
OB=    VB202, 5
ALD
MOVB   10, VB202
LRD
LPS
AB=    VB202, 4
MOVB   11, VB202
LPP
AB=    VB202, 3
MOVB   12, VB202
LPP
LDB=   VB202, 2
OB=    VB202, 1
ALD
MOVB   13, VB202
Network 15 
// Stop sequence: move to the next stop step when its timer is done (10 -> 11 -> 12 -> 13 -> 14)
LDN    I0.2
A      V204.0
LPS
A      T42
MOVB   11, VB202
LRD
A      T43
MOVB   12, VB202
LRD
A      T44
MOVB   13, VB202
LPP
A      T45
MOVB   14, VB202
Network 16 
// Stop step 10: regen valve open, delay before the effluent valve closes (preset VW310)
LDB=   VB202, 10
TON    T42, VW310
Network 17 
// Stop step 11: effluent valve closed, delay before the pump stops (preset VW312)
LDB=   VB202, 11
TON    T43, VW312
Network 18 
// Stop step 12: pump off, delay before the regen valve closes (preset VW314)
LDB=   VB202, 12
TON    T44, VW314
Network 19 
// Stop step 13: regen valve closed, delay before idle (preset VW316)
LDB=   VB202, 13
TON    T45, VW316
Network 20 
Network 21 
Network 22 
// End of state machine sequences
// 
Network 23 
Network 24 
Network 25 
Network 26 
LD     I0.0
EU
=      V230.0
Network 27 
LDN    I1.0
EU
=      V230.1
Network 28 
// Pump: on in states 2-6 and 10-11, or by the HMI (V250.0) in idle (Drain / Rinse)
LDB=   VB202, 2
O      Q0.0
AN     V210.0
AB<>   VB202, 0
AB<>   VB202, 12
LD     V250.0
AB=    VB202, 0
AN     V210.0
OLD
=      Q0.0
Network 29 
// Pump proof timer: pump on without proof (preset VW318)
LD     Q0.0
AN     I1.3
TON    T47, VW318
Network 30 
// Pump fault: latched when the pump has run without proof, cleared by the reset
LD     T47
O      V210.0
AN     V230.1
=      V210.0
Network 31 
Network 32 
LDB<>  VB210, 0
=      Q1.1
Network 33 
LDB<>  VB202, 16
=      Q0.3
Network 34 
LDB=   VB202, 1
O      Q0.1
OB=    VB202, 10
AN     I0.2
AB<>   VB202, 5
AB<>   VB202, 0
AB<>   VB202, 13
=      Q0.1
Network 35 
LDB=   VB202, 4
O      Q0.2
AN     I0.2
AB<>   VB202, 0
AB<>   VB202, 11
=      Q0.2
Network 36 
LDB=   VB202, 6
=      Q1.0
Network 37 
Network 38 
Network 39 
Network 40 
Network 41 
LD     I0.4
EU
=      V242.4
Network 42 
// Bump request latch (not accepted during a pump fault)
LD     V242.4
O      Q0.4
AN     I0.2
AN     V210.0
AN     V242.2
=      Q0.4
Network 43 
// (spare: I1.1 network removed)
Network 44 
// Bumps complete (status light): on when the bump count is reached,
// off when back in running, or at the next Start, Bump or immediate stop
LD     C0
EU
O      Q0.5
AN     V230.0
AN     V242.4
AN     I0.2
AB<>   VB202, 6
=      Q0.5
Network 45 
// Return to running after a bump (V242.6 / Q0.6): set by a bump request in state 6,
// cancelled by Stop (I1.2), the immediate stop (I0.2) or a pump fault (V210.0)
LD     V242.4
AB=    VB202, 6
O      V242.6
AN     I0.2
AN     I1.2
AN     V210.0
AB<>   VB202, 19
AB<>   VB202, 1
=      V242.6
=      Q0.6
Network 46 
Network 47 
Network 48 
// Number of bumps VW0 is written by the HMI (parameter 20, Revive Strokes)
Network 49 
Network 50 
Network 51 
// Bump start sequence to enable process,Enable only on positive trans, stop after count has been reached
LD     Q0.4
O      V242.2
AN     I0.2
AN     C0
AN     Q0.5
AB>=   VB202, 16
AB<=   VB202, 17
=      V242.2
Network 52 
// Bump counter, Reset until bump process start
LD     T61
LDN    V242.2
CTU    C0, VW0
Network 53 
LD     T61
ED
=      V242.1
Network 54 
// Bump off timer, either first time start or bump on timer complete (preset VW320)
LD     V242.2
EU
O      V242.1
AN     C0
A      V242.2
TOF    T60, VW320
Network 55 
// Bump on timer happens after bump off timer completed (preset VW322)
LD     T60
ED
A      V242.2
TOF    T61, VW322
Network 56 
// bump valve control. if not in bump process or not in bump off then valve on
LD     V242.2
AN     T60
=      V242.3
Network 57 
// Stte machine for revival cycle
LDN    I0.2
AN     V204.0
LPS
AB=    VB202, 16
A      V242.3
MOVB   17, VB202
LRD
LDB=   VB202, 15
LDB=   VB202, 17
A      V242.1
OLD
ALD
MOVB   16, VB202
LPP
LPS
AB=    VB202, 18
A      Q0.6
MOVB   19, VB202
LPP
AB=    VB202, 17
A      C0
MOVB   18, VB202
END_ORGANIZATION_BLOCK
SUBROUTINE_BLOCK SBR_0:SBR0
TITLE=SUBROUTINE COMMENTS
BEGIN
Network 1 // Network Title
// Network Comment
END_SUBROUTINE_BLOCK
INTERRUPT_BLOCK INT_0:INT0
TITLE=INTERRUPT ROUTINE COMMENTS
BEGIN
Network 1 // Network Title
// Network Comment
END_INTERRUPT_BLOCK
